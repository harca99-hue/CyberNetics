{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User profile with role-based access information",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "editor", "member"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "MemberProfile": {
      "title": "MemberProfile",
      "type": "object",
      "description": "Student member profile storing private info, XP, rank, and persisted SOC Incident Response simulation states",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "callsign": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "track": { "type": "string", "enum": ["offensive", "defensive", "reverse-engineering", "cloud-sec", "crypto"] },
        "xp": { "type": "number" },
        "rank": { "type": "string", "maxLength": 60 },
        "completedModules": { "type": "object" },
        "moduleStates": { "type": "object" },
        "solvedFlags": { "type": "array", "items": { "type": "string" } },
        "achievements": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "profileName", "track", "xp", "rank", "completedModules", "solvedFlags", "achievements", "createdAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "type": "object",
      "description": "Public non-PII club leaderboard standing for XP and SOC rank",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "profileName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "callsign": { "type": "string", "maxLength": 40 },
        "track": { "type": "string", "enum": ["offensive", "defensive", "reverse-engineering", "cloud-sec", "crypto"] },
        "xp": { "type": "number" },
        "rank": { "type": "string", "maxLength": 60 },
        "solvedCount": { "type": "number" },
        "flagsCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "profileName", "track", "xp", "rank", "solvedCount", "flagsCount", "updatedAt"]
    },
    "ClubSettings": {
      "title": "ClubSettings",
      "type": "object",
      "description": "Global customizable club configuration and announcements",
      "properties": {
        "clubName": { "type": "string" },
        "tagline": { "type": "string" },
        "announcement": { "type": "string" },
        "meetingTime": { "type": "string" },
        "meetingLocation": { "type": "string" },
        "discordUrl": { "type": "string" },
        "contactEmail": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["clubName"]
    },
    "ClubEvent": {
      "title": "ClubEvent",
      "type": "object",
      "description": "Workshops, CTF sessions, guest talks, and security operations",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "rsvpCount": { "type": "number" },
        "isFlagged": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "date", "time", "location", "category"]
    },
    "ResourceItem": {
      "title": "ResourceItem",
      "type": "object",
      "description": "Curated security toolkits, cheat sheets, and wargame links",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "difficulty": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "category", "url"]
    },
    "TeamMember": {
      "title": "TeamMember",
      "type": "object",
      "description": "Executive board members and track leads",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "handle": { "type": "string" },
        "track": { "type": "string" },
        "bio": { "type": "string" },
        "certs": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "role", "track"]
    },
    "RecruitApplication": {
      "title": "RecruitApplication",
      "type": "object",
      "description": "Student cadet registration applications",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "major": { "type": "string" },
        "trackInterest": { "type": "string" },
        "experience": { "type": "string" },
        "flagSolved": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "accepted", "reviewed"] },
        "submittedAt": { "type": "string" }
      },
      "required": ["fullName", "email", "trackInterest"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile records with role assignments"
    },
    "/member_profiles/{userId}": {
      "schema": { "$ref": "#/entities/MemberProfile" },
      "description": "Authenticated student member profiles with XP, rank, CTF flags, and SOC War Room state"
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public non-PII club XP and rank leaderboard standings"
    },
    "/club_settings/{settingId}": {
      "schema": { "$ref": "#/entities/ClubSettings" },
      "description": "Single document 'main' storing dynamic club headlines & info"
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/ClubEvent" },
      "description": "Events and workshops scheduled by the club"
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/entities/ResourceItem" },
      "description": "Curated security guides and tools"
    },
    "/team_members/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Club executive board and track leads"
    },
    "/recruits/{recruitId}": {
      "schema": { "$ref": "#/entities/RecruitApplication" },
      "description": "Cadet enlistment submissions"
    }
  }
}
